# openclaw-raw (native / no Docker) — template for repo root `.env`
#
#   cp .env.raw.example .env
#
# Scripts load only `.env`. For Docker (openclaw-secure), start from `.env.secure.example`.

OPENROUTER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

MESSY_VIRGO_MCP_URL=https://api.messyvirgo.com/mcp
MESSY_VIRGO_API_KEY=

OPENCLAW_CONFIG_DIR=$HOME/.openclaw
OPENCLAW_WORKSPACES_DIR=$HOME/.openclaw/workspaces
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=
