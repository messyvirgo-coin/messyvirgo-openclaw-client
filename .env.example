# Copy to .env and adjust as needed.
# Both openclaw-secure (Docker) and openclaw-raw (native) use this file.

# =============================================================================
# Shared (both modes)
# =============================================================================

# Model provider API keys (set keys for providers you enable)
OPENROUTER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional: only needed if you plan to install/use the Messy Virgo agent pack MCP.
MESSY_VIRGO_MCP_URL=https://api.messyvirgo.com/mcp
MESSY_VIRGO_API_KEY=

# Where OpenClaw stores secrets/config/sessions on your host
OPENCLAW_CONFIG_DIR=$HOME/.openclaw-secure

# Root host folder containing one workspace per agent (main, mv-coder, mv-researcher, mv-planner)
OPENCLAW_WORKSPACES_DIR=$HOME/OpenClawWorkspaces

# Gateway port (default 18789)
OPENCLAW_GATEWAY_PORT=18789

# If empty, setup generates a random token and writes it here
OPENCLAW_GATEWAY_TOKEN=

# =============================================================================
# OpenClaw-secure (Docker) only
# =============================================================================

# Git repo to clone for building (default: upstream; override for fork or mirror)
OPENCLAW_GIT_REPO=https://github.com/openclaw/openclaw

# Default workspace path (compose mount target; keep as "<WORKSPACES_DIR>/main")
OPENCLAW_WORKSPACE_DIR=$HOME/OpenClawWorkspaces/main

# Bridge port (used by Docker compose)
OPENCLAW_BRIDGE_PORT=18790

# Keep bind as 'lan' inside the container (ports still localhost-only on host)
OPENCLAW_GATEWAY_BIND=lan

# Image tag built by openclaw-secure/scripts/setup.sh
OPENCLAW_IMAGE=openclaw-secure:local

# Optional: override OpenClaw Dockerfile Node base (default upstream is Node 24 bookworm).
# If the gateway sits at ~100% CPU and never listens on OPENCLAW_GATEWAY_PORT, try Node 22 LTS:
# OPENCLAW_NODE_BOOKWORM_IMAGE=node:22-bookworm

# npm cache path used by openclaw-cli in read-only containers
OPENCLAW_NPM_CACHE_DIR=/tmp/.npm

# npm version baked into the runtime image for plugin installs
OPENCLAW_NPM_VERSION=11.11.1

# Optional: install extra apt packages during image build (space-separated)
OPENCLAW_DOCKER_APT_PACKAGES=jq

# Where to clone OpenClaw source for builds
OPENCLAW_SRC_DIR=$HOME/.openclaw-secure/openclaw-src

# =============================================================================
# Openclaw-raw (native) only
# =============================================================================

# Path to skills directory (config/openclaw.native.json uses this)
# Optional. Resolved relative to repo root when not absolute.
# Examples (relative, portable):
#   OPENCLAW_SKILLS_DIR=skills
#   OPENCLAW_SKILLS_DIR=./skills
# Absolute example: OPENCLAW_SKILLS_DIR=$HOME/other-repo/skills
# Leave empty to default to <repo>/skills
OPENCLAW_SKILLS_DIR=
