# openclaw-secure (Docker) — template for repo root `.env`
#
#   cp .env.secure.example .env
#
# Scripts load only `.env` at the repo root. For native (no Docker), start from
# `.env.raw.example` instead.

# =============================================================================
# Shared (keys + paths used by the container mounts)
# =============================================================================

OPENROUTER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

MESSY_VIRGO_MCP_URL=https://api.messyvirgo.com/mcp
MESSY_VIRGO_API_KEY=

# Host paths → mounted into the gateway (defaults: config ~/.openclaw if unset; override for extra envs)
# OPENCLAW_CONFIG_DIR=$HOME/.openclaw
OPENCLAW_WORKSPACES_DIR=$HOME/OpenClawWorkspaces
OPENCLAW_WORKSPACE_DIR=$HOME/OpenClawWorkspaces/main

OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
# Bridge mode: lan is fine (ports map to 127.0.0.1). Linux hostnet stack overrides to loopback in scripts.
OPENCLAW_GATEWAY_BIND=lan

# If empty, setup.sh generates a token and writes it here
OPENCLAW_GATEWAY_TOKEN=

# =============================================================================
# Docker build / image (openclaw-secure only)
# =============================================================================

OPENCLAW_GIT_REPO=https://github.com/openclaw/openclaw
# OPENCLAW_GIT_REF=main

OPENCLAW_IMAGE=openclaw-secure:local
# Optional: override OpenClaw git checkout for image build (default: ~/.openclaw/openclaw-src)
# OPENCLAW_SRC_DIR=$HOME/.openclaw/openclaw-src

# OPENCLAW_NODE_BOOKWORM_IMAGE=node:22-bookworm
OPENCLAW_NPM_CACHE_DIR=/tmp/.npm
OPENCLAW_NPM_VERSION=11.11.1
OPENCLAW_DOCKER_APT_PACKAGES=jq
