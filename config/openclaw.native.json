{
  "discovery": {
    "mdns": {
      "mode": "minimal"
    }
  },

  "logging": {
    "redactSensitive": "tools"
  },

  "tools": {
    "web": {
      "search": {
        "provider": "tavily",
        "maxResults": 5,
        "timeoutSeconds": 30
      },
      "fetch": {
        "enabled": true
      }
    }
  },

  "session": {
    "dmScope": "per-channel-peer"
  },

  "memory": {
    "citations": "auto"
  },

  "models": {
    "mode": "merge",
    "providers": {
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKey": "${OPENROUTER_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "google/gemini-2.5-flash-lite",
            "name": "Gemini Flash-Lite",
            "contextWindow": 1000000,
            "maxTokens": 8192
          },
          {
            "id": "anthropic/claude-haiku-4-5",
            "name": "Claude Haiku 4.5",
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "anthropic/claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6",
            "contextWindow": 1000000,
            "maxTokens": 8192
          },
          {
            "id": "anthropic/claude-opus-4-6",
            "name": "Claude Opus 4.6",
            "contextWindow": 1000000,
            "maxTokens": 8192
          },
          {
            "id": "openai/gpt-5.4-mini",
            "name": "GPT-5.4 Mini",
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "x-ai/grok-4.1-fast",
            "name": "Grok 4.1 Fast",
            "contextWindow": 256000,
            "maxTokens": 8192
          },
          {
            "id": "minimax/minimax-m2.5",
            "name": "MiniMax M2.5",
            "reasoning": true,
            "contextWindow": 196608,
            "maxTokens": 8192
          },
          {
            "id": "moonshotai/kimi-k2.5",
            "name": "Kimi K2.5",
            "reasoning": true,
            "contextWindow": 262144,
            "maxTokens": 8192
          }
        ]
      }
    }
  },

  "agents": {
    "defaults": {
      "thinkingDefault": "low",
      "contextTokens": 200000,

      "memorySearch": {
        "enabled": true,
        "provider": "openai",
        "model": "openai/text-embedding-3-small",
        "fallback": "none",
        "remote": {
          "baseUrl": "https://openrouter.ai/api/v1",
          "apiKey": "${OPENROUTER_API_KEY}"
        },
        "store": {
          "path": "~/.openclaw/memory/{agentId}.sqlite"
        },
        "experimental": {
          "sessionMemory": true
        },
        "sources": ["memory", "sessions"],
        "sync": {
          "sessions": {
            "deltaBytes": 100000,
            "deltaMessages": 50
          }
        },
        "query": {
          "hybrid": {
            "enabled": true,
            "vectorWeight": 0.7,
            "textWeight": 0.3,
            "mmr": {
              "enabled": true,
              "lambda": 0.7
            },
            "temporalDecay": {
              "enabled": true,
              "halfLifeDays": 30
            }
          }
        },
        "cache": {
          "enabled": true,
          "maxEntries": 50000
        }
      },

      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "10m",
        "keepLastAssistants": 4,
        "softTrimRatio": 0.65,
        "hardClearRatio": 0.88,
        "minPrunableToolChars": 1200
      },

      "compaction": {
        "mode": "default",
        "reserveTokensFloor": 40000,
        "keepRecentTokens": 20000,
        "maxHistoryShare": 0.65,
        "model": "openrouter/google/gemini-2.5-flash-lite",
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 4000,
          "systemPrompt": "Session nearing compaction. Store durable memories now.",
          "prompt": "Write any lasting notes to memory/YYYY-MM-DD.md; reply with NO_REPLY if nothing to store."
        }
      },

      "heartbeat": {
        "every": "30m",
        "model": "openrouter/google/gemini-2.5-flash-lite",
        "target": "last",
        "lightContext": true,
        "isolatedSession": true
      },

      "subagents": {
        "maxConcurrent": 8
      },

      "workspace": "${OPENCLAW_WORKSPACES_DIR}/main",

      "model": {
        "primary": "openrouter/x-ai/grok-4.1-fast"
      },

      "models": {
        "openrouter/x-ai/grok-4.1-fast": {
          "alias": "or-grok",
          "params": { "temperature": 0.2 }
        },
        "openrouter/google/gemini-2.5-flash-lite": {
          "alias": "or-flashlite",
          "params": { "temperature": 0.2 }
        },
        "openrouter/anthropic/claude-haiku-4-5": {
          "alias": "or-haiku",
          "params": { "temperature": 0.2 }
        },
        "openrouter/anthropic/claude-sonnet-4-6": {
          "alias": "or-sonnet",
          "params": { "temperature": 0.2 }
        },
        "openrouter/anthropic/claude-opus-4-6": {
          "alias": "or-opus",
          "params": { "temperature": 0.2 }
        },
        "openrouter/openai/gpt-5.4-mini": {
          "alias": "or-gpt",
          "params": { "temperature": 0.2 }
        },
        "openrouter/minimax/minimax-m2.5": {
          "alias": "or-minimax",
          "params": { "temperature": 0.2 }
        },
        "openrouter/moonshotai/kimi-k2.5": {
          "alias": "or-kimi",
          "params": { "temperature": 0.2 }
        }
      },

      "sandbox": {
        "mode": "all",
        "scope": "session",
        "workspaceAccess": "none",
        "workspaceRoot": "~/.openclaw/sandboxes",
        "prune": {
          "idleHours": 12,
          "maxAgeDays": 3
        }
      }
    },

    "list": [
      {
        "id": "main",
        "default": true,
        "name": "Messy Virgo",
        "identity": {
          "name": "Messy Virgo"
        },
        "workspace": "${OPENCLAW_WORKSPACES_DIR}/main",
        "model": "openrouter/x-ai/grok-4.1-fast"
      }
    ]
  },

  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "controlUi": {
      "dangerouslyAllowHostHeaderOriginFallback": false,
      "allowedOrigins": [
        "http://127.0.0.1:${OPENCLAW_GATEWAY_PORT}",
        "http://localhost:${OPENCLAW_GATEWAY_PORT}"
      ]
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  },

  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },

  "channels": {
    "telegram": {
      "enabled": true,
      "defaultAccount": "main",
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "streaming": "off"
    }
  },

  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "session-memory": {
          "enabled": true
        }
      }
    }
  },

  "skills": {
    "load": {
      "extraDirs": [
        "${OPENCLAW_SKILLS_DIR}"
      ],
      "watch": true
    }
  },

  "plugins": {
    "entries": {
      "memory-core": {
        "enabled": true,
        "config": {
          "dreaming": {
            "enabled": true
          }
        }
      },
      "telegram": {
        "enabled": true
      },
      "tavily": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "${TAVILY_API_KEY}"
          }
        }
      }
    }
  }
}
